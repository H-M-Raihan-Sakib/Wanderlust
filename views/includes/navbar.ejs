<div class="collapse navbar-collapse" id="navbarNavAltMarkup">

  <!-- Left -->
  <div class="navbar-nav">
    <a class="nav-link" href="/listings">Explore</a>
  </div>

  <!-- Center (Search) -->
  <form class="d-flex align-items-center gap-2 mx-auto my-2 my-lg-0" action="/listings/search" method="GET">
    <input 
      class="form-control rounded-pill px-3" 
      type="search" 
      placeholder="Search destinations"
      name="country"
    >
    <button class="btn btn-danger rounded-pill px-3">
      <i class="fa-solid fa-magnifying-glass"></i>
    </button>
  </form>

  <!-- Right -->
  <div class="navbar-nav ms-auto align-items-lg-center">
    
    <div class="form-check form-switch me-3">
      <input class="form-check-input" type="checkbox" id="flexSwitchCheckChecked">
      <label class="form-check-label">Tax</label>
    </div>

    <button class="btn btn-outline-primary m-1">Add</button>

    <% if(!currUser){ %>
      <button class="btn btn-danger m-1">Sign Up</button>
      <button class="btn btn-success m-1">Log In</button>
    <% } %>

    <% if(currUser){ %>
      <button class="btn btn-dark m-1">Log Out</button>
    <% } %>

  </div>

</div>
